# MongoDB connection string (local mongod instance)
NUXT_MONGOOSE_URI=mongodb://127.0.0.1:27017/spolu

# Absolute or relative path for stored photos.
# In production you can set for example: /var/www/spolu/data/uploads
NUXT_UPLOADS_DIR=.data/uploads

# Optional UI version marker (visible in header/login).
# Useful to confirm a new deployment is really running.
# Default is from the package.json version field.
NUXT_PUBLIC_APP_VERSION=0.0.0

# Optional build marker shown next to the version, e.g. the short git commit.
# Does not trigger release notes, so it is safe for repeated test deployments:
#   NUXT_PUBLIC_APP_BUILD=$(git rev-parse --short HEAD) npm run build
NUXT_PUBLIC_APP_BUILD=

# Session cookie encryption key - at least 32 characters.
# Nuxt Auth Utils will auto-generate one in dev if left empty, but set an
# explicit value for production.
NUXT_SESSION_PASSWORD=change-this-to-a-random-string-of-at-least-32-chars

# Mapy.cz API key for geocoding and routing. Get one at https://api.mapy.com/
NUXT_MAPY_API_KEY=your-mapy-api-key-here